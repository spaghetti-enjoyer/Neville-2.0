{
    "files.associations": {
        "vector": "cpp",
        "__split_buffer": "cpp",
        "array": "cpp",
        "deque": "cpp",
        "list": "cpp",
        "queue": "cpp",
        "span": "cpp",
        "string": "cpp",
        "string_view": "cpp"
    },

    "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",

    "C_Cpp.default.includePath": [
        "${workspaceFolder}/include",
        "${workspaceFolder}/dependencies/serial/include",
        "${workspaceFolder}/opencv-install/include",
        "${workspaceFolder}/opencv-install/include/opencv4"
    ],
    "C_Cpp.default.cppStandard": "c++17"
}